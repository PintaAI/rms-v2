// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff
  technician
  superuser
}

enum TokoStatus {
  active
  inactive
}

enum SubscriptionPlan {
  free
  premium
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
}

enum SubscriptionInvoiceStatus {
  issued
  pending_review
  paid
  rejected
  overdue
  void
}

enum SubscriptionPaymentStatus {
  pending_review
  approved
  rejected
}

enum SubscriptionPaymentMethod {
  bank_transfer
  qris
  ewallet
  other
}

enum TokoUserRole {
  owner
}

enum ServiceStatus {
  received
  repairing
  done
  failed
}

enum ItemType {
  sparepart
  service
}

enum ActivityType {
  service_created
  service_updated
  service_deleted
  service_status_changed
  service_assigned
  service_taken_over
  invoice_created
  invoice_paid
  invoice_dp
  sparepart_created
  sparepart_updated
  sparepart_deleted
  sparepart_stock_in
  sparepart_stock_out
  inventory_audit_started
  inventory_audit_completed
  inventory_audit_cancelled
  inventory_audit_stock_adjusted
}

enum InventoryAuditStatus {
  active
  completed
  cancelled
}

enum InventoryAuditItemStatus {
  pending
  matched
  discrepancy
}

enum InventoryAuditMismatchReason {
  used_in_service_not_recorded
  lost
  damaged
  incoming_stock_not_recorded
  previous_stock_error
  physical_count_error
  other
}

enum PaymentStatus {
  unpaid
  dp
  paid
}

enum AffiliatorStatus {
  active
  inactive
}

enum AffiliateCommissionType {
  fixed
  percentage
}

enum AffiliateCommissionStatus {
  pending
  approved
  paid
  rejected
}

//////////////////////
// MODELS
//////////////////////

model Toko {
  id        String     @id @default(uuid())
  name      String
  address   String?
  phone     String?
  logoUrl   String?
  invoiceTerms    String?
  invoiceWarranty String?
  status    TokoStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userAssignments  UserToko[]
  spareparts       Sparepart[]
  sparepartCategories SparepartCategory[]
  servicePricelists ServicePricelist[]
  services         Service[]
  activities       ActivityLog[]
  inventoryAuditSessions InventoryAuditSession[]
  featureSetting   TokoFeatureSetting?
  whatsappSetting  TokoWhatsappSetting?

  @@index([status])
  @@map("toko")
}

model TokoFeatureSetting {
  tokoId           String   @id
  disabledFeatures Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  toko Toko @relation(fields: [tokoId], references: [id], onDelete: Cascade)

  @@map("toko_feature_setting")
}

model TokoWhatsappSetting {
  tokoId String @id

  instanceName         String  @unique
  enabled              Boolean @default(true)
  connectedNumber      String?
  connectedProfileName String?

  notifyDone   Boolean @default(true)
  notifyFailed Boolean @default(true)

  doneMessageTemplate   String?
  failedMessageTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  toko Toko @relation(fields: [tokoId], references: [id], onDelete: Cascade)

  @@map("toko_whatsapp_setting")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  password      String?
  role          UserRole @default(admin)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions       Session[]
  accounts       Account[]
  tokoAssignments UserToko[]
  subscription   Subscription?
  subscriptionInvoices SubscriptionInvoice[]
  reviewedSubscriptionPayments SubscriptionPayment[] @relation("SubscriptionPaymentReviewedBy")
  createdServices  Service[]    @relation("ServiceCreatedBy")
  assignedServices Service[]    @relation("ServiceTechnician")
  activities      ActivityLog[]
  createdInventoryAuditSessions InventoryAuditSession[] @relation("InventoryAuditCreatedBy")
  affiliatorProfile Affiliator?
  referredByReferral Referral?
  affiliateCommissions AffiliateCommission[]

  @@index([role])
  @@map("user")
}

model UserToko {
  userId   String
  tokoId   String
  role     TokoUserRole @default(owner)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  toko Toko @relation(fields: [tokoId], references: [id], onDelete: Cascade)

  @@id([userId, tokoId])
  @@index([userId])
  @@index([tokoId])
  @@map("user_toko")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  plan      SubscriptionPlan   @default(free)
  status    SubscriptionStatus @default(trialing)

  trialEndsAt        DateTime?
  proTrialStartedAt  DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceEndsAt        DateTime?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices SubscriptionInvoice[]

  @@index([plan])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([trialEndsAt])
  @@map("subscription")
}

model SubscriptionInvoice {
  id             String                    @id @default(uuid())
  invoiceNumber  String                    @unique
  userId         String
  subscriptionId String

  plan                SubscriptionPlan
  amount              Int
  tokoCount           Int
  includedTokos       Int?
  additionalTokos     Int @default(0)
  additionalTokoPrice Int?

  status   SubscriptionInvoiceStatus @default(issued)
  issuedAt DateTime                  @default(now())
  dueAt    DateTime
  paidAt   DateTime?
  voidedAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
  @@map("subscription_invoice")
}

model SubscriptionPayment {
  id        String                    @id @default(uuid())
  invoiceId String

  amount          Int
  method          SubscriptionPaymentMethod @default(bank_transfer)
  referenceNumber String?
  proofUrl        String?
  note            String?
  status          SubscriptionPaymentStatus @default(pending_review)
  rejectionReason String?

  submittedAt  DateTime @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoice    SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("SubscriptionPaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status])
  @@index([reviewedById])
  @@map("subscription_payment")
}

model Affiliator {
  id     String  @id @default(uuid())
  userId String? @unique

  name  String
  email String?
  phone String?

  code        String           @unique
  portalToken String           @unique
  status      AffiliatorStatus @default(active)

  commissionType            AffiliateCommissionType @default(fixed)
  premiumCommissionValue    Int                     @default(100000)
  enterpriseCommissionValue Int                     @default(200000)

  payoutInfo Json?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  referrals   Referral[]
  commissions AffiliateCommission[]

  @@index([status])
  @@index([email])
  @@map("affiliator")
}

model Referral {
  id             String   @id @default(uuid())
  affiliatorId   String
  referredUserId String   @unique
  referralCode   String
  convertedAt    DateTime?
  createdAt      DateTime @default(now())

  affiliator   Affiliator @relation(fields: [affiliatorId], references: [id])
  referredUser User       @relation(fields: [referredUserId], references: [id])

  commissions AffiliateCommission[]

  @@index([affiliatorId])
  @@index([referralCode])
  @@index([createdAt])
  @@map("referral")
}

model AffiliateCommission {
  id         String                    @id @default(uuid())
  affiliatorId String
  referralId   String
  userId       String
  plan       SubscriptionPlan
  amount     Int
  status     AffiliateCommissionStatus @default(pending)
  createdAt  DateTime                  @default(now())
  approvedAt DateTime?
  paidAt     DateTime?
  rejectedAt DateTime?
  notes      String?

  affiliator Affiliator @relation(fields: [affiliatorId], references: [id])
  referral   Referral   @relation(fields: [referralId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([referralId, plan])
  @@index([affiliatorId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("affiliate_commission")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Global Brand model (not toko-specific) - available across all tokos
model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hpCatalogs HpCatalog[]

  @@map("brand")
}

// Global HpCatalog model (not toko-specific) - available across all tokos
model HpCatalog {
  id          String   @id @default(uuid())
  brandId     String
  modelName   String
  modelNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand           Brand                    @relation(fields: [brandId], references: [id])
  services        Service[]
  compatibilities SparepartCompatibility[]

  @@unique([brandId, modelName])
  @@index([brandId, modelName])
  @@map("hp_catalog")
}

model Sparepart {
  id           String  @id @default(uuid())
  barcode      String
  name         String
  defaultPrice Int
  purchasePrice Int?
  supplierName String?
  categoryId String?
  stock        Int     @default(0)
  criticalStock Int    @default(5)
  isUniversal  Boolean @default(false)
  tokoId       String

  toko            Toko                     @relation(fields: [tokoId], references: [id])
  category        SparepartCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  compatibilities SparepartCompatibility[]
  serviceItems    ServiceItem[]
  inventoryAuditItems InventoryAuditItem[]

  @@unique([tokoId, name])
  @@unique([tokoId, barcode])
  @@index([tokoId])
  @@index([categoryId])
  @@map("sparepart")
}

model SparepartCategory {
  id        String   @id @default(uuid())
  name      String
  tokoId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  toko       Toko        @relation(fields: [tokoId], references: [id])
  spareparts Sparepart[]

  @@unique([tokoId, name])
  @@index([tokoId])
  @@map("sparepart_category")
}

model SparepartCompatibility {
  hpCatalogId String
  sparepartId String

  hpCatalog HpCatalog @relation(fields: [hpCatalogId], references: [id])
  sparepart Sparepart @relation(fields: [sparepartId], references: [id])

  @@id([hpCatalogId, sparepartId])
  @@map("sparepart_compatibility")
}

model ServicePricelist {
  id           String @id @default(uuid())
  title        String
  defaultPrice Int
  tokoId       String

  toko Toko @relation(fields: [tokoId], references: [id])

  @@unique([tokoId, title])
  @@index([tokoId])
  @@map("service_pricelist")
}

model Service {
  id String @id @default(uuid())

  tokoId      String
  hpCatalogId String

  // 👇 role dipisah
  createdById  String
  technicianId String?

  imei            String?
  customerName    String?
  noWa            String
  complaint       String
  handlingNote    String?
  includedItems   Json?
  passwordPattern String?
  note            String?

  status      ServiceStatus @default(received)
  isPickedUp  Boolean       @default(false)

  checkinAt  DateTime  @default(now())
  assignedAt DateTime?
  doneAt     DateTime?
  warrantyUntil DateTime?
  checkoutAt DateTime?

  // 👇 anti double WA
  doneNotifiedAt DateTime?

  toko      Toko      @relation(fields: [tokoId], references: [id])
  hpCatalog HpCatalog @relation(fields: [hpCatalogId], references: [id])

  createdBy  User  @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  technician User? @relation("ServiceTechnician", fields: [technicianId], references: [id])

  items   ServiceItem[]
  invoice Invoice?

  activities ActivityLog[]

  @@index([tokoId])
  @@index([status])
  @@index([checkinAt])
  @@index([noWa])
  @@index([technicianId])
  @@index([tokoId, status])
  @@index([tokoId, checkinAt])
  @@map("service")
}

model ServiceItem {
  id        String @id @default(uuid())
  serviceId String

  type        ItemType
  referenceId String?

  name  String
  qty   Int    @default(1)
  price Int

  service   Service    @relation(fields: [serviceId], references: [id])
  sparepart Sparepart? @relation(fields: [referenceId], references: [id], map: "service_item_sparepart_fk")

  @@index([serviceId])
  @@index([type])
  @@index([referenceId])
  @@map("service_item")
}

model Invoice {
  id        String @id @default(uuid())
  serviceId String @unique

  grandTotal    Int
  paymentStatus PaymentStatus @default(unpaid)
  dpAmount      Int      @default(0)
  discountAmount Int     @default(0)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  service Service @relation(fields: [serviceId], references: [id])
  items   InvoiceItem[]

  @@map("invoice")
}

model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String
  serviceItemId String?
  type          ItemType
  referenceId   String?
  name          String
  qty           Int
  price         Int
  createdAt     DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([serviceItemId])
  @@map("invoice_item")
}

model InventoryAuditSession {
  id          String               @id @default(uuid())
  tokoId      String
  createdById String
  status      InventoryAuditStatus @default(active)
  startedAt   DateTime             @default(now())
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  toko      Toko @relation(fields: [tokoId], references: [id], onDelete: Cascade)
  createdBy User @relation("InventoryAuditCreatedBy", fields: [createdById], references: [id])
  items     InventoryAuditItem[]

  @@index([tokoId])
  @@index([createdById])
  @@index([status])
  @@index([tokoId, status])
  @@index([tokoId, startedAt])
  @@map("inventory_audit_session")
}

model InventoryAuditItem {
  id                 String                         @id @default(uuid())
  sessionId          String
  sparepartId        String
  sparepartName      String
  systemStock        Int
  physicalStock      Int?
  snapshotPrice         Int
  snapshotPurchasePrice Int                            @default(0)
  status             InventoryAuditItemStatus       @default(pending)
  mismatchReason     InventoryAuditMismatchReason?
  note               String?
  difference         Int                            @default(0)
  missingQty         Int                            @default(0)
  excessQty          Int                            @default(0)
  differenceValue    Int                            @default(0)
  potentialLostValue Int                            @default(0)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  session   InventoryAuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sparepart Sparepart             @relation(fields: [sparepartId], references: [id])

  @@unique([sessionId, sparepartId])
  @@index([sessionId])
  @@index([sessionId, sparepartName])
  @@index([sparepartId])
  @@index([status])
  @@map("inventory_audit_item")
}

//////////////////////
// LOGGING & NOTIF
//////////////////////

model ActivityLog {
  id        String @id @default(uuid())
  tokoId    String
  serviceId String?
  userId    String

  type    ActivityType
  title   String
  payload Json?

  createdAt DateTime @default(now())

  toko    Toko    @relation(fields: [tokoId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([tokoId])
  @@index([serviceId])
  @@index([userId])
  @@index([type])
  @@index([tokoId, createdAt])
  @@map("activity_log")
}

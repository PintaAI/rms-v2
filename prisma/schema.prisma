// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff
  technician
  superuser
}

enum StoreStatus {
  active
  inactive
}

enum SubscriptionPlan {
  free
  premium
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
}

enum SubscriptionInvoiceStatus {
  issued
  pending_review
  paid
  rejected
  overdue
  void
}

enum SubscriptionPaymentStatus {
  pending_review
  approved
  rejected
}

enum SubscriptionPaymentMethod {
  bank_transfer
  qris
  ewallet
  other
}

enum StoreUserRole {
  owner
}

enum PermissionEffect {
  allow
  deny
}

enum RepairOrderStatus {
  received
  repairing
  done
  failed
}

enum RepairOrderItemType {
  inventory_item
  service_catalog_item
}

enum RepairInvoiceItemType {
  inventory_item
  service_catalog_item
}

enum InventoryItemType {
  repair_part
  retail_product
  phone_unit
}

enum InventoryMovementType {
  restock
  repair_usage
  repair_return
  repair_delete_return
  sales_order
  sales_order_void
  audit_adjustment
  supplier_return_replacement
  unit_acquired
  unit_sold
  unit_returned
  unit_adjusted
}

enum InventoryUnitCondition {
  new
  used_good
  used_fair
  refurbished
  damaged
}

enum InventoryUnitStatus {
  available
  reserved
  sold
  returned
  defective
}

enum SalesOrderStatus {
  paid
  void
}

enum SalesPaymentMethod {
  cash
  transfer
  qris
  debit
}

enum ActivityType {
  user_login
  service_created
  service_updated
  service_deleted
  service_status_changed
  service_assigned
  service_taken_over
  invoice_created
  invoice_paid
  invoice_dp
  warranty_claim_created
  warranty_claim_resolved
  sparepart_created
  sparepart_updated
  sparepart_deleted
  sparepart_stock_in
  sparepart_stock_out
  inventory_audit_started
  inventory_audit_completed
  inventory_audit_cancelled
  inventory_audit_stock_adjusted
  supplier_return_created
  supplier_return_sent
  supplier_return_replaced
  supplier_return_refunded
  supplier_return_rejected
}

enum SupplierReturnStatus {
  pending
  sent
  replaced
  refunded
  rejected
}

enum InventoryAuditStatus {
  active
  completed
  cancelled
}

enum InventoryAuditItemStatus {
  pending
  matched
  discrepancy
}

enum InventoryAuditMismatchReason {
  used_in_service_not_recorded
  lost
  damaged
  incoming_stock_not_recorded
  previous_stock_error
  physical_count_error
  other
}

enum PaymentStatus {
  unpaid
  dp
  paid
}

enum SupplierPayableStatus {
  unpaid
  partial
  paid
}

enum WarrantyClaimStatus {
  open
  resolved
  rejected
}

enum WarrantyClaimResolution {
  free_repair
  replace_part
  cash_refund
  no_action
}

enum AffiliatorStatus {
  active
  inactive
}

enum AffiliateCommissionType {
  fixed
  percentage
}

enum AffiliateCommissionStatus {
  pending
  approved
  paid
  rejected
}

enum AffiliateCommissionKind {
  registration_bonus
  pro_recurring
  enterprise_one_time
}

//////////////////////
// MODELS
//////////////////////

model Store {
  id              String     @id @default(uuid())
  name            String
  address         String?
  phone           String?
  logoUrl         String?
  invoiceTerms    String?
  invoiceWarranty String?
  status          StoreStatus @default(active)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  userAssignments        UserStore[]
  inventoryItems         InventoryItem[]
  inventoryCategories    InventoryCategory[]
  serviceCatalogItems    ServiceCatalogItem[]
  repairOrders           RepairOrder[]
  warrantyClaims         WarrantyClaim[]
  supplierReturns        SupplierReturn[]
  activities             ActivityLog[]
  inventoryAuditSessions InventoryAuditSession[]
  inventoryMovements     InventoryMovement[]
  salesOrders            SalesOrder[]
  suppliers              Supplier[]
  supplierPayables       SupplierPayable[]
  featureSetting         StoreFeatureSetting?
  whatsappSetting        StoreWhatsappSetting?
  whatsappIdentities     StoreWhatsappIdentity[]
  userPermissions        StoreUserPermission[]

  @@index([status])
  @@map("store")
}

model StoreFeatureSetting {
  storeId          String   @id
  disabledFeatures Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_feature_setting")
}

model StoreWhatsappSetting {
  storeId String @id

  instanceName         String  @unique
  instanceToken        String?
  enabled              Boolean @default(true)
  connectedNumber      String?
  connectedProfileName String?

  notifyDone   Boolean @default(true)
  notifyFailed Boolean @default(true)

  doneMessageTemplate   String?
  failedMessageTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_whatsapp_setting")
}

model StoreWhatsappIdentity {
  id          String   @id @default(cuid())
  storeId     String
  phoneNumber String
  phoneJid    String?
  lidJid      String?
  displayName String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, phoneNumber])
  @@index([storeId, phoneJid])
  @@index([storeId, lidJid])
  @@map("store_whatsapp_identity")
}

model User {
  id                            String                  @id
  name                          String
  email                         String                  @unique
  emailVerified                 Boolean                 @default(false)
  image                         String?
  password                      String?
  role                          UserRole                @default(admin)
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  sessions                      Session[]
  accounts                      Account[]
  storeAssignments              UserStore[]
  subscription                  Subscription?
  subscriptionInvoices          SubscriptionInvoice[]
  reviewedSubscriptionPayments  SubscriptionPayment[]   @relation("SubscriptionPaymentReviewedBy")
  createdRepairOrders           RepairOrder[]           @relation("RepairOrderCreatedBy")
  assignedRepairOrders          RepairOrder[]           @relation("RepairOrderTechnician")
  createdWarrantyClaims         WarrantyClaim[]         @relation("WarrantyClaimCreatedBy")
  resolvedWarrantyClaims        WarrantyClaim[]         @relation("WarrantyClaimResolvedBy")
  createdSupplierReturns        SupplierReturn[]        @relation("SupplierReturnCreatedBy")
  resolvedSupplierReturns       SupplierReturn[]        @relation("SupplierReturnResolvedBy")
  activities                    ActivityLog[]
  createdInventoryAuditSessions InventoryAuditSession[] @relation("InventoryAuditCreatedBy")
  inventoryMovements            InventoryMovement[]
  salesOrders                   SalesOrder[]
  affiliatorProfile             Affiliator?
  referredByReferral            Referral?
  affiliateCommissions          AffiliateCommission[]
  storePermissions              StoreUserPermission[]

  @@index([role])
  @@map("user")
}

model UserStore {
  userId    String
  storeId   String
  role      StoreUserRole @default(owner)
  createdAt DateTime     @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@map("user_store")
}

model StoreUserPermission {
  id            String           @id @default(cuid())
  storeId       String
  userId        String
  permissionKey String
  effect        PermissionEffect
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, permissionKey])
  @@index([storeId, userId])
  @@index([userId])
  @@map("store_user_permission")
}

model Subscription {
  id     String             @id @default(uuid())
  userId String             @unique
  plan   SubscriptionPlan   @default(free)
  status SubscriptionStatus @default(trialing)

  trialEndsAt        DateTime?
  proTrialStartedAt  DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceEndsAt        DateTime?
  cancelledAt        DateTime?
  monthlyPriceOverride Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices SubscriptionInvoice[]

  @@index([plan])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([trialEndsAt])
  @@map("subscription")
}

model SubscriptionInvoice {
  id             String @id @default(uuid())
  invoiceNumber  String @unique
  userId         String
  subscriptionId String

  plan                SubscriptionPlan
  amount              Int
  storeCount          Int
  includedStores      Int?
  additionalStores    Int              @default(0)
  additionalStorePrice Int?

  status   SubscriptionInvoiceStatus @default(issued)
  issuedAt DateTime                  @default(now())
  dueAt    DateTime
  paidAt   DateTime?
  voidedAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
  @@map("subscription_invoice")
}

model SubscriptionPayment {
  id        String @id @default(uuid())
  invoiceId String

  amount          Int
  method          SubscriptionPaymentMethod @default(bank_transfer)
  referenceNumber String?
  proofUrl        String?
  note            String?
  status          SubscriptionPaymentStatus @default(pending_review)
  rejectionReason String?

  submittedAt  DateTime  @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invoice    SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("SubscriptionPaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status])
  @@index([reviewedById])
  @@map("subscription_payment")
}

model Affiliator {
  id     String  @id @default(uuid())
  userId String? @unique

  name  String
  email String?
  phone String?

  code        String           @unique
  portalToken String           @unique
  status      AffiliatorStatus @default(active)

  commissionType            AffiliateCommissionType @default(percentage)
  premiumCommissionValue    Int                     @default(10)
  enterpriseCommissionValue Int                     @default(10)

  payoutInfo Json?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  referrals   Referral[]
  commissions AffiliateCommission[]

  @@index([status])
  @@index([email])
  @@map("affiliator")
}

model Referral {
  id                           String    @id @default(uuid())
  affiliatorId                 String
  referredUserId               String    @unique
  referralCode                 String
  registrationCommissionAmount Int       @default(50000)
  convertedAt                  DateTime?
  createdAt                    DateTime  @default(now())

  affiliator   Affiliator @relation(fields: [affiliatorId], references: [id])
  referredUser User       @relation(fields: [referredUserId], references: [id])

  commissions AffiliateCommission[]

  @@index([affiliatorId])
  @@index([referralCode])
  @@index([createdAt])
  @@map("referral")
}

model AffiliateCommission {
  id                   String                    @id @default(uuid())
  affiliatorId         String
  referralId           String
  userId               String
  plan                 SubscriptionPlan
  kind                 AffiliateCommissionKind   @default(registration_bonus)
  periodKey            String                    @default("legacy")
  periodStart          DateTime?
  periodEnd            DateTime?
  commissionBaseAmount Int?
  amount               Int
  status               AffiliateCommissionStatus @default(pending)
  createdAt            DateTime                  @default(now())
  approvedAt           DateTime?
  paidAt               DateTime?
  rejectedAt           DateTime?
  notes                String?

  affiliator Affiliator @relation(fields: [affiliatorId], references: [id])
  referral   Referral   @relation(fields: [referralId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([referralId, plan, kind, periodKey])
  @@index([affiliatorId])
  @@index([userId])
  @@index([kind])
  @@index([status])
  @@index([createdAt])
  @@map("affiliate_commission")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Global DeviceBrand model (not store-specific) - available across all stores
model DeviceBrand {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deviceModels DeviceModel[]

  @@map("device_brand")
}

// Global DeviceModel model (not store-specific) - available across all stores
model DeviceModel {
  id          String   @id @default(uuid())
  brandId     String
  modelName   String
  modelNumber String?
  mobileApiId String?  @unique
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand           DeviceBrand         @relation(fields: [brandId], references: [id])
  repairOrders    RepairOrder[]
  inventoryItems  InventoryItem[]
  compatibilities PartCompatibility[]

  @@unique([brandId, modelName])
  @@index([brandId, modelName])
  @@map("device_model")
}

model InventoryItem {
  id            String            @id @default(uuid())
  barcode       String
  name          String
  defaultPrice  Int
  purchasePrice Int?
  supplierName  String?
  categoryId    String?
  stock         Int               @default(0)
  criticalStock Int               @default(5)
  warrantyDays  Int?
  isUniversal   Boolean           @default(false)
  type          InventoryItemType @default(repair_part)
  metadata      Json?
  storeId       String
  deviceModelId String?

  store               Store                @relation(fields: [storeId], references: [id])
  category            InventoryCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  deviceModel         DeviceModel?         @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)
  compatibilities     PartCompatibility[]
  repairOrderItems    RepairOrderItem[]
  warrantyClaimItems  WarrantyClaimItem[]
  supplierReturns     SupplierReturn[]
  inventoryAuditItems InventoryAuditItem[]
  inventoryMovements  InventoryMovement[]
  salesOrderItems     SalesOrderItem[]

  @@index([storeId, name])
  @@unique([storeId, barcode])
  @@index([storeId])
  @@index([categoryId])
  @@index([deviceModelId])
  @@map("inventory_item")
}

model InventoryCategory {
  id        String   @id @default(uuid())
  name      String
  kind      InventoryItemType @default(repair_part)
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store          Store           @relation(fields: [storeId], references: [id])
  inventoryItems InventoryItem[]

  @@unique([storeId, kind, name])
  @@index([storeId])
  @@index([storeId, kind])
  @@map("inventory_category")
}

model Supplier {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  phone     String?
  address   String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payables SupplierPayable[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("supplier")
}

model SupplierPayable {
  id            String             @id @default(uuid())
  storeId       String
  supplierId    String
  invoiceNumber String?
  description   String?
  totalAmount   Int
  paidAmount    Int                @default(0)
  dueDate       DateTime?
  status        SupplierPayableStatus @default(unpaid)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  store    Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier                 @relation(fields: [supplierId], references: [id])
  payments SupplierPayablePayment[]

  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@map("supplier_payable")
}

model SupplierPayablePayment {
  id          String   @id @default(uuid())
  payableId   String
  amount      Int
  paymentDate DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())

  payable SupplierPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([payableId])
  @@index([paymentDate])
  @@map("supplier_payable_payment")
}

model PartCompatibility {
  deviceModelId   String
  inventoryItemId String

  deviceModel   DeviceModel   @relation(fields: [deviceModelId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@id([deviceModelId, inventoryItemId])
  @@map("part_compatibility")
}

model ServiceCatalogItem {
  id           String @id @default(uuid())
  title        String
  defaultPrice Int
  storeId      String

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, title])
  @@index([storeId])
  @@map("service_catalog_item")
}

model RepairOrder {
  id String @id @default(uuid())

  storeId       String
  deviceModelId String

  // 👇 role dipisah
  createdById  String
  technicianId String?

  imei            String?
  customerName    String?
  noWa            String
  complaint       String
  handlingNote    String?
  includedItems   Json?
  passwordPattern String?
  note            String?

  status     RepairOrderStatus @default(received)
  isPickedUp Boolean       @default(false)

  checkinAt     DateTime  @default(now())
  assignedAt    DateTime?
  doneAt        DateTime?
  warrantyUntil DateTime?
  checkoutAt    DateTime?

  // 👇 anti double WA
  doneNotifiedAt DateTime?

  store       Store       @relation(fields: [storeId], references: [id])
  deviceModel DeviceModel @relation(fields: [deviceModelId], references: [id])

  createdBy  User  @relation("RepairOrderCreatedBy", fields: [createdById], references: [id])
  technician User? @relation("RepairOrderTechnician", fields: [technicianId], references: [id])

  items          RepairOrderItem[]
  invoice        RepairInvoice?
  warrantyClaims WarrantyClaim[]

  activities ActivityLog[]

  @@index([storeId])
  @@index([status])
  @@index([checkinAt])
  @@index([noWa])
  @@index([technicianId])
  @@index([storeId, status])
  @@index([storeId, checkinAt])
  @@index([storeId, noWa])
  @@map("repair_order")
}

model RepairOrderItem {
  id            String @id @default(uuid())
  repairOrderId String

  type        RepairOrderItemType
  referenceId String?

  name  String
  qty   Int    @default(1)
  price Int

  repairOrder   RepairOrder    @relation(fields: [repairOrderId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [referenceId], references: [id], map: "repair_order_item_inventory_item_fk")

  @@index([repairOrderId])
  @@index([type])
  @@index([referenceId])
  @@map("repair_order_item")
}

model RepairInvoice {
  id            String @id @default(uuid())
  repairOrderId String @unique

  grandTotal     Int
  paymentStatus  PaymentStatus @default(unpaid)
  dpAmount       Int           @default(0)
  discountAmount Int           @default(0)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  repairOrder RepairOrder         @relation(fields: [repairOrderId], references: [id])
  items       RepairInvoiceItem[]

  @@map("repair_invoice")
}

model RepairInvoiceItem {
  id              String   @id @default(uuid())
  repairInvoiceId String
  repairOrderItemId String?
  type          RepairInvoiceItemType
  referenceId   String?
  name          String
  qty           Int
  price         Int
  createdAt     DateTime @default(now())

  repairInvoice RepairInvoice @relation(fields: [repairInvoiceId], references: [id], onDelete: Cascade)

  @@index([repairInvoiceId])
  @@index([repairOrderItemId])
  @@map("repair_invoice_item")
}

model SalesOrder {
  id             String              @id @default(uuid())
  storeId        String
  createdById    String
  customerName   String?
  customerPhone  String?
  subtotal       Int
  discountAmount Int                 @default(0)
  grandTotal     Int
  paymentMethod  SalesPaymentMethod
  cashReceived   Int?
  changeAmount   Int?
  status         SalesOrderStatus    @default(paid)
  paidAt         DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User             @relation(fields: [createdById], references: [id])
  items     SalesOrderItem[]

  @@index([storeId])
  @@index([createdById])
  @@index([status])
  @@index([paymentMethod])
  @@index([paidAt])
  @@index([storeId, paidAt])
  @@map("sales_order")
}

model SalesOrderItem {
  id                   String            @id @default(uuid())
  salesOrderId         String
  inventoryItemId      String?
  name                 String
  barcode              String?
  kind                 InventoryItemType
  qty                  Int
  unitPrice            Int
  unitCostSnapshot     Int?
  warrantyDaysSnapshot Int?
  warrantyUntil        DateTime?
  lineTotal            Int
  createdAt            DateTime          @default(now())

  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([salesOrderId])
  @@index([inventoryItemId])
  @@index([kind])
  @@map("sales_order_item")
}

model WarrantyClaim {
  id        String @id @default(uuid())
  storeId   String
  repairOrderId String

  status     WarrantyClaimStatus      @default(open)
  resolution WarrantyClaimResolution?

  reason         String
  customerNote   String?
  technicianNote String?
  refundAmount   Int     @default(0)
  resolvedNote   String?

  createdById  String
  resolvedById String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  store           Store               @relation(fields: [storeId], references: [id])
  repairOrder     RepairOrder         @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("WarrantyClaimCreatedBy", fields: [createdById], references: [id])
  resolvedBy      User?               @relation("WarrantyClaimResolvedBy", fields: [resolvedById], references: [id])
  items           WarrantyClaimItem[]
  supplierReturns SupplierReturn[]

  @@index([storeId])
  @@index([repairOrderId])
  @@index([status])
  @@index([createdAt])
  @@map("warranty_claim")
}

model SupplierReturn {
  id              String  @id @default(uuid())
  storeId         String
  warrantyClaimId String?
  inventoryItemId String

  qty          Int
  supplierName String?
  reason       String
  status       SupplierReturnStatus @default(pending)

  refundAmount Int     @default(0)
  note         String?

  createdById  String
  resolvedById String?
  createdAt    DateTime  @default(now())
  sentAt       DateTime?
  resolvedAt   DateTime?

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warrantyClaim WarrantyClaim? @relation(fields: [warrantyClaimId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  createdBy     User           @relation("SupplierReturnCreatedBy", fields: [createdById], references: [id])
  resolvedBy    User?          @relation("SupplierReturnResolvedBy", fields: [resolvedById], references: [id])

  @@index([storeId])
  @@index([warrantyClaimId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([createdAt])
  @@map("supplier_return")
}

model WarrantyClaimItem {
  id              String  @id @default(uuid())
  warrantyClaimId String
  inventoryItemId String?

  name  String
  qty   Int    @default(1)
  price Int    @default(0)

  warrantyClaim WarrantyClaim  @relation(fields: [warrantyClaimId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([warrantyClaimId])
  @@index([inventoryItemId])
  @@map("warranty_claim_item")
}

model InventoryAuditSession {
  id          String               @id @default(uuid())
  storeId     String
  createdById String
  status      InventoryAuditStatus @default(active)
  startedAt   DateTime             @default(now())
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  store     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("InventoryAuditCreatedBy", fields: [createdById], references: [id])
  items     InventoryAuditItem[]

  @@index([storeId])
  @@index([createdById])
  @@index([status])
  @@index([storeId, status])
  @@index([storeId, startedAt])
  @@map("inventory_audit_session")
}

model InventoryAuditItem {
  id                    String                        @id @default(uuid())
  sessionId             String
  inventoryItemId       String
  inventoryItemName     String
  systemStock           Int
  physicalStock         Int?
  snapshotPrice         Int
  snapshotPurchasePrice Int                           @default(0)
  status                InventoryAuditItemStatus      @default(pending)
  mismatchReason        InventoryAuditMismatchReason?
  note                  String?
  difference            Int                           @default(0)
  missingQty            Int                           @default(0)
  excessQty             Int                           @default(0)
  differenceValue       Int                           @default(0)
  potentialLostValue    Int                           @default(0)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  session       InventoryAuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem         @relation(fields: [inventoryItemId], references: [id])

  @@unique([sessionId, inventoryItemId])
  @@index([sessionId])
  @@index([sessionId, inventoryItemName])
  @@index([inventoryItemId])
  @@index([status])
  @@map("inventory_audit_item")
}

model InventoryMovement {
  id                String            @id @default(uuid())
  storeId           String
  inventoryItemId   String?
  type              InventoryMovementType
  qtyChange         Int
  stockBefore       Int
  stockAfter        Int
  unitCostSnapshot  Int?
  unitPriceSnapshot Int?
  referenceType     String?
  referenceId       String?
  note              String?
  createdById       String
  createdAt         DateTime          @default(now())

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  createdBy     User          @relation(fields: [createdById], references: [id])

  @@index([storeId])
  @@index([inventoryItemId])
  @@index([createdById])
  @@index([type])
  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movement")
}

//////////////////////
// LOGGING & NOTIF
//////////////////////

model ActivityLog {
  id        String  @id @default(uuid())
  storeId   String
  repairOrderId String?
  userId    String

  type    ActivityType
  title   String
  payload Json?

  createdAt DateTime @default(now())

  store       Store        @relation(fields: [storeId], references: [id])
  repairOrder RepairOrder? @relation(fields: [repairOrderId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([repairOrderId])
  @@index([userId])
  @@index([type])
  @@index([storeId, createdAt])
  @@map("activity_log")
}
